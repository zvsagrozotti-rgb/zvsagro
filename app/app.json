{
  "expo": {
    "name": "FrotaFácil",
    "slug": "vzsagro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.wftavares.frotafacil",
      "versionCode": 1,
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#051520",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#051520",
          "imageWidth": 240
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O FrotaFácil usa a câmera para fotografar o cupom fiscal e preencher os dados. A foto é lida no próprio aparelho."
        }
      ]
    ]
  }
}
